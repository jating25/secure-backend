generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model User {
  id                  Int       @id @default(autoincrement())

  name                String
  email               String    @unique
  password            String

  role                Role      @default(USER)
  isActive            Boolean   @default(true)

  refreshToken        String?

  // Increment this to revoke all existing access tokens
  tokenVersion        Int       @default(0)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Relations
  logs                Log[]
  requests            Request[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Request {
  id          Int             @id @default(autoincrement())

  title       String
  description String

  status      RequestStatus   @default(PENDING)

  createdBy   Int
  user        User            @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Log {
  id         Int       @id @default(autoincrement())

  userId     Int?

  action     String
  endpoint   String
  method     String
  statusCode Int

  ip         String?
  userAgent  String?

  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
}